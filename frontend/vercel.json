{
  "redirects": [
    {
      "source": "/admin",
      "destination": "https://jay-veer-enterprise.onrender.com/admin/",
      "permanent": false
    },
    {
      "source": "/admin/:path*",
      "destination": "https://jay-veer-enterprise.onrender.com/admin/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
